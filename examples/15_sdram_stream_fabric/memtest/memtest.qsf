# memtest: generated by scripts/new_project.py, re-run it instead of editing (extras go in src/extra.qsf)
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY memtest_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
# every array written as a RAM goes into M9K. With this On (the MAX 10 default) Quartus guesses the M9Ks are
# running out (e.g. next to debug_link's 114-block frame buffer) and silently builds small RAMs from
# flip-flops: fft_lab used 19,381 LEs instead of about 8,100. A design that really needs too many M9Ks
# now stops in the fitter with a clear error.
set_global_assignment -name SYNTH_RESOURCE_AWARE_INFERENCE_FOR_BLOCK_RAM OFF
# a chain of 3 or more registers (a pipeline's flags, a synchronizer) is otherwise folded into an M9K as an
# altshift_taps, merged across modules: example 15's six CDC synchronizers and six units' pipeline flags
# each became one M9K. Memories are written as memories here; a shift register stays flip-flops.
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name SDC_FILE memtest.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../../../lib/rtl/sdram_burst_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../lib/rtl/sdram_memtest.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../lib/rtl/jtag_regs.sv
set_global_assignment -name VERILOG_FILE ../../../lib/rtl/pll_de10_dps.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../../lib/rtl/pll_phase_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../lib/rtl/seg7_char.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/memtest_top.sv
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50
set_location_assignment PIN_U17 -to DRAM_ADDR[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DRAM_ADDR[0]
