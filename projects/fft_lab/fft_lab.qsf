# fft_lab: generated by scripts/new_project.py, re-run it instead of editing (extras go in src/extra.qsf)
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY fft_lab_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
# every array written as a RAM goes into M9K. With this On (the MAX 10 default) Quartus guesses the M9Ks are
# running out (e.g. next to debug_link's 114-block frame buffer) and silently builds small RAMs from
# flip-flops: fft_lab used 19,381 LEs instead of about 8,100. A design that really needs too many M9Ks
# now stops in the fitter with a clear error.
set_global_assignment -name SYNTH_RESOURCE_AWARE_INFERENCE_FOR_BLOCK_RAM OFF
set_global_assignment -name SDC_FILE fft_lab.sdc
set_global_assignment -name QIP_FILE ../../lib/rtl/pll25.qip
set_global_assignment -name VERILOG_FILE ../../lib/rtl/vga_controller.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/lcd_ctrl.sv
set_global_assignment -name QIP_FILE ../../lib/rtl/lcd_cmd.qip
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/Screens_dispaly.sv
set_global_assignment -name QIP_FILE ../../lib/rtl/adc/synthesis/adc.qip
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/analog_input.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/gamepad.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/jtag_uart.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/debug_link.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/font8x8.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/seven_segment.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/line_printer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/bin2bcd_seq.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/tx_mux.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../lib/rtl/debounce.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/fft_lab_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/fft_lab_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/fft_r2.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/lab_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/lab_digits.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/lab_draw.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/lab_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/mag_px.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/mag_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/wave_gen.sv
set_global_assignment -name QIP_FILE ip/fft256/fft256.qip
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50
